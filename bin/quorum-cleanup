#!/usr/bin/env python3
"""quorum-cleanup: runs each provider's `cleanup` command (once, as written) from your config and the catalog, then
prints free disk. Cleanup commands must only touch things quorum itself created (see providers.catalog.json)."""
import os, shutil, sys
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import quorum_lib as q
cfg = q.load_json(q.find_config())
env = dict(os.environ, QUORUM_BIN=q.HERE)
for name, p in q.providers(cfg).items():
    c = p.get("cleanup") if isinstance(p, dict) else None
    if isinstance(c, str): q.run_limited(c, env, os.getcwd(), 120)
subprocess_run = __import__("subprocess").run
subprocess_run([os.path.join(q.HERE, "quorum-doctor"), "--fix"], stdout=__import__("subprocess").DEVNULL)
du = shutil.disk_usage("/")
print(f"free disk: {du.free / 1e9:.0f} GB")
